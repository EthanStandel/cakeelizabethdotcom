{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "env",
      "runtimeArgs": ["-u", "PORT", "npm", "run", "dev"],
      "port": 5173
    },
    {
      "name": "dev-no-mail",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "-u",
        "PORT",
        "NO_MAIL=true",
        "NO_MAIL_DELAY=2000",
        "npm",
        "run",
        "dev"
      ],
      "port": 5173
    },
    {
      "name": "production-build",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "PORT=3100",
        "NO_MAIL=true",
        "SITE_URL=http://localhost:3100",
        "node",
        ".output/server/index.mjs"
      ],
      "port": 3100
    }
  ]
}

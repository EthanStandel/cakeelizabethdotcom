{
  "name": "example-basic",
  "type": "module",
  "scripts": {
    "generate:cms": "tsx scripts/generate-cms-config.ts",
    "generate:cms:dev": "tsx scripts/generate-cms-config.ts --dev",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:env": "tsx scripts/validate-env.ts",
    "validate:redirects": "tsx scripts/validate-redirects.ts",
    "check:redirects": "tsx scripts/check-redirects.ts",
    "predev": "npm run generate:cms:dev",
    "dev": "concurrently --names \"CLIENT,ADMIN,DECAP,CMS\" --hide \"DECAP\" --pad-prefix --prefix-colors \"cyan,magenta,yellow,green\" \"NODE_OPTIONS=--inspect vite dev\" \"npm run dev:admin\" \"decap-server\" \"npm run dev:cms\"",
    "dev:admin": "vite dev --config vite.config.admin.ts",
    "dev:cms": "tsx scripts/generate-cms-config.ts --dev --watch",
    "prebuild": "npm run validate:env && npm run generate:cms && npm run build:admin && npm run validate:content && npm run validate:redirects",
    "build": "vite build && vite build --config vite.config.admin.ts",
    "build:admin": "vite build --config vite.config.admin.ts",
    "start": "node .output/server/index.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sendgrid/mail": "^8.1.6",
    "@solidjs/meta": "^0.29.4",
    "@solidjs/router": "^1.0.0",
    "@solidjs/start": "^2.0.6",
    "@tailwindcss/vite": "^4.3.0",
    "@types/lodash": "^4.17.24",
    "cva": "npm:class-variance-authority@^0.7.1",
    "decap-cms-app": "^3.12.2",
    "gray-matter": "^4.0.3",
    "lodash": "^4.18.1",
    "lucide-solid": "^1.17.0",
    "marked": "^18.0.3",
    "nitro": "^3.0.260903-beta",
    "solid-js": "^1.9.5",
    "tailwindcss": "^4.3.0",
    "vite": "^8.3.4",
    "zod": "^4.4.3"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.8.0",
    "concurrently": "^9.2.1",
    "decap-server": "^3.7.0",
    "js-yaml": "^4.1.1",
    "prettier": "^3.9.5",
    "tsx": "^4.22.0",
    "typescript": "^6.0.3"
  }
}
